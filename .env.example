# Copy this file to .env and fill in real values. Do NOT commit .env.
# The pipeline reads these same names from GitHub Actions Secrets.

# MongoDB Atlas connection string (with URL-encoded password if it contains special chars)
MONGO_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/studentDB?retryWrites=true&w=majority&appName=<cluster>

# Flask session signing key (any long random string; generate with: openssl rand -hex 32)
SECRET_KEY=change-me
